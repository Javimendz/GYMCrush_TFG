<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark"
    android:orientation="vertical">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/primary_dark">

        <ImageView
            android:id="@+id/btnBackDieta"
            android:layout_width="@dimen/button_height"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_small"
            android:padding="@dimen/spacing_small"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/brand_pink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nutrición Inteligente"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <!-- BLOQUE A: MI ESTADO ACTUAL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi Estado Actual"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_small"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="@dimen/stroke_width_thin"
                android:layout_marginBottom="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:hint="Peso"
                            app:startIconDrawable="@android:drawable/ic_menu_sort_by_size"
                            app:startIconTint="@color/brand_pink"
                            app:suffixText="kg"
                            app:suffixTextColor="@color/brand_pink"
                            app:boxBackgroundColor="@android:color/transparent"
                            app:hintTextColor="@color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPeso"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_size_body" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:hint="Altura"
                            app:startIconDrawable="@android:drawable/ic_menu_compass"
                            app:startIconTint="@color/brand_pink"
                            app:suffixText="cm"
                            app:suffixTextColor="@color/brand_pink"
                            app:boxBackgroundColor="@android:color/transparent"
                            app:hintTextColor="@color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAltura"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_size_body" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:hint="Edad"
                            app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
                            app:startIconTint="@color/brand_pink"
                            app:boxBackgroundColor="@android:color/transparent"
                            app:hintTextColor="@color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEdad"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_size_body" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:hint="Actividad"
                            app:boxBackgroundColor="@android:color/transparent"
                            app:hintTextColor="@color/white">
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/spinnerActividad"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_size_body" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:hint="Objetivo"
                        app:boxBackgroundColor="@android:color/transparent"
                        app:hintTextColor="@color/white">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/spinnerObjetivo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActualizarDatos"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="Generar Mi Plan Personalizado"
                        android:backgroundTint="@color/brand_pink"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:cornerRadius="@dimen/spacing_small" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BLOQUE B: SUGERENCIA DEL COACH AI -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sugerencia del Coach AI"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_small"/>

            <!-- Empty State for Suggestion -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmptySuggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="@dimen/stroke_width_thin"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/spacing_large">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_xlarge"
                    android:text="Completa tu perfil de salud para que podamos recomendarte una dieta."
                    android:textColor="#BDBDBD"
                    android:gravity="center"
                    android:textSize="@dimen/text_size_body"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Suggestion Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSuggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_surface_light"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="@dimen/stroke_width_thin"
                android:layout_marginBottom="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TU PLAN IDEAL"
                        android:textColor="@color/brand_pink"
                        android:textSize="@dimen/text_size_micro"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tvNombreDietaSugerida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="Dieta Hipercalórica"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_header"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:gravity="center_vertical">

                        <!-- Donut Chart -->
                        <com.example.gymcrush.ui.custom.CustomDonutChart
                            android:id="@+id/donutChartMacros"
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium" />

                        <!-- Macros Data -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_large"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <View android:layout_width="@dimen/spacing_small" android:layout_height="@dimen/spacing_small" android:background="@color/macro_protein" />
                                <TextView
                                    android:id="@+id/tvProt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_small"
                                    android:text="180g Proteína"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_body" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_small"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <View android:layout_width="@dimen/spacing_small" android:layout_height="@dimen/spacing_small" android:background="@color/macro_carbs" />
                                <TextView
                                    android:id="@+id/tvCarbs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_small"
                                    android:text="350g Carbos"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_body" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_small"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <View android:layout_width="@dimen/spacing_small" android:layout_height="@dimen/spacing_small" android:background="@color/macro_fats" />
                                <TextView
                                    android:id="@+id/tvGrasas"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_small"
                                    android:text="80g Grasas"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_body" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/spacing_large">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/tvCaloriasSugeridas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 kcal consumidas"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvCaloriasRestantes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2000"
                                    android:textColor="@color/brand_pink"
                                    android:textSize="@dimen/text_size_title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_tiny"
                                    android:text="restantes"
                                    android:textColor="#BDBDBD"
                                    android:textSize="@dimen/text_size_caption" />
                            </LinearLayout>
                        </RelativeLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressCalorias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            app:indicatorColor="@color/brand_pink"
                            app:trackColor="#33FFFFFF"
                            app:trackThickness="@dimen/spacing_small"
                            app:trackCornerRadius="@dimen/spacing_tiny"
                            android:progress="0" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_width_thin"
                        android:background="#1AFFFFFF"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:layout_marginBottom="@dimen/spacing_small" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:layout_marginBottom="@dimen/spacing_small">

                        <TextView
                            android:id="@+id/tvTituloComidas"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TU MENÚ DIARIO"
                            android:textColor="#BDBDBD"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold"
                            android:singleLine="true" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBuscarComida"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:paddingHorizontal="@dimen/spacing_tiny"
                                android:text="Buscar"
                                android:textColor="@color/brand_pink"
                                android:textSize="@dimen/text_size_micro"
                                app:icon="@android:drawable/ic_menu_search"
                                app:iconPadding="@dimen/spacing_tiny"
                                app:iconSize="@dimen/spacing_medium"
                                app:iconTint="@color/brand_pink" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddComidaManual"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:paddingHorizontal="@dimen/spacing_tiny"
                                android:text="Añadir"
                                android:textColor="@color/brand_pink"
                                android:textSize="@dimen/text_size_micro"
                                app:icon="@android:drawable/ic_input_add"
                                app:iconPadding="@dimen/spacing_tiny"
                                app:iconSize="@dimen/spacing_medium"
                                app:iconTint="@color/brand_pink" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvComidasSugeridas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_comida_dieta" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BLOQUE C: HISTORIAL DE PLANES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis Planes Anteriores"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_small"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistorialNutricion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_large"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_nutricion_historial" />

            <!-- BLOQUE D: EXPLORAR TODAS LAS DIETAS -->
            <TextView
                android:id="@+id/tvTituloCatalogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Catálogo de Dietas"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_small"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCatalogoDietas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_dieta_catalogo"
                android:layout_marginBottom="@dimen/spacing_large"/>

            <!-- BLOQUE E: RECETAS SALUDABLES -->
            <TextView
                android:id="@+id/tvTituloRecetas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recetas de la Comunidad"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_small"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecetasSugeridas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_receta_card"
                android:layout_marginBottom="@dimen/spacing_large"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
