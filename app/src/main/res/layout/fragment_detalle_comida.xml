<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F111E"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <ImageButton
            android:id="@+id/btnBackDetalleComida"
            android:layout_width="@dimen/button_height"
            android:layout_height="@dimen/button_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvTituloDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Detalle de Comida"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/food_detail_image_height"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <ImageView
                    android:id="@+id/ivComidaDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_compras" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvNombreComidaDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="PB Cookies"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMomentoDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="Desayuno"
                android:textColor="#B0B0B0"
                android:textSize="@dimen/text_size_body" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_width_thin"
                android:layout_marginVertical="@dimen/spacing_large"
                android:background="#33FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MACRONUTRIENTES"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:columnCount="2"
                android:rowCount="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calorías"
                        android:textColor="#B0B0B0" />
                    <TextView
                        android:id="@+id/tvCalDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="490 kcal"
                        android:textColor="#E91E63"
                        android:textSize="@dimen/text_size_subheading"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proteínas"
                        android:textColor="#B0B0B0" />
                    <TextView
                        android:id="@+id/tvProtDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="49g"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_subheading"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carbohidratos"
                        android:textColor="#B0B0B0" />
                    <TextView
                        android:id="@+id/tvCarbDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="31g"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_subheading"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grasas"
                        android:textColor="#B0B0B0" />
                    <TextView
                        android:id="@+id/tvGrasDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19g"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_subheading"
                        android:textStyle="bold" />
                </LinearLayout>
            </GridLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="DESCRIPCIÓN"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescripcionDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="No hay descripción disponible para esta comida."
                android:textColor="#B0B0B0"
                android:textSize="@dimen/text_size_body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerRecetaWeb"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="VER RECETA COMPLETA"
                android:visibility="gone"
                app:cornerRadius="@dimen/card_corner_radius_small"
                android:backgroundTint="#CD0277"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnadirMiDieta"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="Añadir a mi dieta"
                app:cornerRadius="@dimen/card_corner_radius_small"
                android:backgroundTint="#4CAF50"
                app:icon="@android:drawable/ic_input_add"
                app:iconGravity="textStart"/>

            <TextView
                android:id="@+id/tvLabelRecetaWeb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="RECETA"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cvWebViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/spacing_medium"
                android:minHeight="400dp"
                android:visibility="gone"
                app:cardBackgroundColor="#1A1C2E"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="0dp">

                <WebView
                    android:id="@+id/wvReceta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>