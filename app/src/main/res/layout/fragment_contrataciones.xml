<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark"
    android:orientation="vertical">

    <!-- Header con el color azul oscuro y flecha de volver -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/primary_dark">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/button_height"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_small"
            android:padding="@dimen/spacing_medium"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/brand_pink"
            android:contentDescription="Volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contrataciones actuales"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Ficha de detalles -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_medium"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:cardBackgroundColor="@color/card_surface"
        app:strokeColor="#1AFFFFFF"
        app:strokeWidth="@dimen/stroke_width_thin">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_large">

            <TextView
                android:id="@+id/tvCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCESO SALA MUSCULACIÓN"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Inicio -->
            <ImageView
                android:id="@+id/ivIcon1"
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:layout_marginTop="@dimen/spacing_large"
                android:contentDescription="Icono Inicio"
                android:src="@drawable/ic_clases"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCardTitle"
                app:tint="@color/brand_pink" />

            <TextView
                android:id="@+id/tvLabel1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:text="Inicio última cuota:"
                android:textColor="#B0B0B0"
                android:textSize="@dimen/text_size_body"
                app:layout_constraintBottom_toBottomOf="@id/ivIcon1"
                app:layout_constraintStart_toEndOf="@id/ivIcon1"
                app:layout_constraintTop_toTopOf="@id/ivIcon1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08/04/2025"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvLabel1"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Fin -->
            <ImageView
                android:id="@+id/ivIcon2"
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:layout_marginTop="@dimen/spacing_medium"
                android:contentDescription="Icono Fin"
                android:src="@drawable/ic_clases"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivIcon1"
                app:tint="@color/brand_pink" />

            <TextView
                android:id="@+id/tvLabel2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:text="Fin última cuota:"
                android:textColor="#B0B0B0"
                android:textSize="@dimen/text_size_body"
                app:layout_constraintBottom_toBottomOf="@id/ivIcon2"
                app:layout_constraintStart_toEndOf="@id/ivIcon2"
                app:layout_constraintTop_toTopOf="@id/ivIcon2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08/04/2026"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvLabel2"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Clases -->
            <ImageView
                android:id="@+id/ivIcon3"
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:layout_marginTop="@dimen/spacing_medium"
                android:contentDescription="Icono Clases"
                android:src="@drawable/ic_reservaclases"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivIcon2"
                app:tint="@color/brand_pink" />

            <TextView
                android:id="@+id/tvLabel3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:text="Clases utilizadas:"
                android:textColor="#B0B0B0"
                android:textSize="@dimen/text_size_body"
                app:layout_constraintBottom_toBottomOf="@id/ivIcon3"
                app:layout_constraintStart_toEndOf="@id/ivIcon3"
                app:layout_constraintTop_toTopOf="@id/ivIcon3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 996"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvLabel3"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Importe -->
            <ImageView
                android:id="@+id/ivIcon4"
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:layout_marginTop="@dimen/spacing_medium"
                android:contentDescription="Icono Importe"
                android:src="@drawable/ic_compras"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivIcon3"
                app:tint="@color/brand_pink" />

            <TextView
                android:id="@+id/tvLabel4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:text="Importe:"
                android:textColor="#B0B0B0"
                android:textSize="@dimen/text_size_body"
                app:layout_constraintBottom_toBottomOf="@id/ivIcon4"
                app:layout_constraintStart_toEndOf="@id/ivIcon4"
                app:layout_constraintTop_toTopOf="@id/ivIcon4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="290,00 €"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvLabel4"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Estado -->
            <ImageView
                android:id="@+id/ivIcon5"
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:layout_marginTop="@dimen/spacing_medium"
                android:contentDescription="Icono Estado"
                android:src="@drawable/ic_equipo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivIcon4"
                app:tint="@color/brand_pink" />

            <TextView
                android:id="@+id/tvLabel5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:text="Estado:"
                android:textColor="#B0B0B0"
                android:textSize="@dimen/text_size_body"
                app:layout_constraintBottom_toBottomOf="@id/ivIcon5"
                app:layout_constraintStart_toEndOf="@id/ivIcon5"
                app:layout_constraintTop_toTopOf="@id/ivIcon5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pagado"
                android:textColor="#4CAF50"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvLabel5"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>