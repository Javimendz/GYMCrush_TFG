<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#0A1128">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_dialog_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Entrenador"
            android:textColor="#CD0277"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tv_dialog_descripcion"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Descripción detallada aquí..."
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cerrar_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENTENDIDO"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="#CD0277"
            app:cornerRadius="16dp"
            app:elevation="4dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>