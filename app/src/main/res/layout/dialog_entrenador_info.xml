<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A2238"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tv_dialog_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Entrenador"
            android:textColor="#CD0277"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_dialog_descripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción detallada aquí..."
            android:textColor="@color/white"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_cerrar_dialog"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_salir"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#CD0277"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>

</LinearLayout>
