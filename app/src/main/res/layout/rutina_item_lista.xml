<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp">

        <ImageView
            android:id="@+id/imgRutina"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/cardio" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B30A1128" />

        <LinearLayout
            android:id="@+id/layoutHeaderPlan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:padding="16dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvNombrePlanPertenece"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAN: FUERZA"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnMasOpciones"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="bottom">

            <TextView
                android:id="@+id/tvNombreRutina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sentadillas"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <!-- Etiquetas de Duración e Intensidad -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- Tag Duración -->
                <LinearLayout
                    android:id="@+id/layoutDuracionTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_duration_tag"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_duration"
                        app:tint="#FFC107"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tvDuracionTagItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 min"
                        android:textColor="#FFC107"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tag Intensidad -->
                <LinearLayout
                    android:id="@+id/layoutIntensidadTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_neon_card"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvIntensidadTagItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MEDIA"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tag Global/Personal -->
                <LinearLayout
                    android:id="@+id/layoutGlobalTagEntrenamiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_global"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/tvGlobalTagEntrenamiento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFICIAL"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDetallesRutina"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 sets x 12 reps"
                    android:textColor="#FFFFFF"
                    android:alpha="0.8"
                    android:textSize="14sp"/>

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="#66FFFFFF" />

                <TextView
                    android:id="@+id/tvEstadoRutina"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMPEZAR"
                    android:textColor="#CD0277"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/imgStatusCheck"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/checkbox_on_background"
                    app:tint="#4CAF50"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>