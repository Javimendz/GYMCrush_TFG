<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/card_corner_radius_large"
    app:cardElevation="@dimen/card_elevation_large"
    app:cardBackgroundColor="@color/card_surface"
    app:strokeColor="#4DFFFFFF"
    app:strokeWidth="@dimen/stroke_width_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EDITAR MENSAJE"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_large"
            android:letterSpacing="0.1"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mensaje"
            android:textColorHint="#99FFFFFF"
            app:hintTextColor="@color/brand_pink"
            app:boxStrokeColor="@color/brand_pink">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_editar_mensaje_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body"
                android:inputType="textMultiLine"
                android:maxLines="4"/>
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="@dimen/spacing_large">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancelar_edicion_mensaje"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:text="CANCELAR"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/text_size_body"
                android:layout_marginEnd="@dimen/spacing_small"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_guardar_edicion_mensaje"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:text="GUARDAR"
                android:textColor="@color/white"
                app:backgroundTint="@color/brand_pink"
                app:cornerRadius="@dimen/card_corner_radius_small"
                android:textSize="@dimen/text_size_body"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>