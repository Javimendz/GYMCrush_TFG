<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#1A1A1A"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNombreEjercicio"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Nombre del Ejercicio"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <CheckBox
                android:id="@+id/cbSeleccionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#E91E63"/>
        </LinearLayout>

        <!-- Apartado para Series y Repeticiones (Solo visible si está seleccionado) -->
        <LinearLayout
            android:id="@+id/layoutDetallesSeleccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Series:"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etSeries"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:hint="4"
                android:textColor="@color/white"
                android:textColorHint="#44FFFFFF"
                android:backgroundTint="#E91E63"
                android:inputType="number"
                android:textSize="14sp"
                android:textAlignment="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reps:"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="16dp"/>

            <EditText
                android:id="@+id/etRepeticiones"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:hint="12"
                android:textColor="@color/white"
                android:textColorHint="#44FFFFFF"
                android:backgroundTint="#E91E63"
                android:inputType="number"
                android:textSize="14sp"
                android:textAlignment="center"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>