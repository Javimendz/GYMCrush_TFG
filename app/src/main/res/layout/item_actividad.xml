<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_medium"
    android:layout_marginVertical="@dimen/spacing_small"
    app:cardBackgroundColor="#1E2640"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="#33FF4081"
    app:strokeWidth="@dimen/stroke_width_thin">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivActividad"
            android:layout_width="match_parent"
            android:layout_height="@dimen/workout_image_height"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_neon_card"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_gradient_card"
            app:layout_constraintBottom_toBottomOf="@id/ivActividad"
            app:layout_constraintTop_toTopOf="@id/ivActividad" />

        <ImageButton
            android:id="@+id/btnEditActividad"
            android:layout_width="@dimen/icon_size_medium"
            android:layout_height="@dimen/icon_size_medium"
            android:layout_margin="@dimen/spacing_small"
            android:background="@drawable/bg_circle_glass"
            android:src="@android:drawable/ic_menu_edit"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_medium"
            app:layout_constraintTop_toBottomOf="@id/ivActividad">

            <TextView
                android:id="@+id/tvNombreActividad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Yoga"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvCategoria"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neon_card"
                android:backgroundTint="@color/brand_pink"
                android:paddingHorizontal="@dimen/spacing_small"
                android:paddingVertical="@dimen/spacing_tiny"
                android:text="CARDIO"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_micro"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/tvNombreActividad"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvNombreActividad" />

            <LinearLayout
                android:id="@+id/layoutInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/tvNombreActividad">

                <ImageView
                    android:layout_width="@dimen/spacing_medium"
                    android:layout_height="@dimen/spacing_medium"
                    android:src="@drawable/ic_location"
                    app:tint="#99FFFFFF" />

                <TextView
                    android:id="@+id/tvSala"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_tiny"
                    android:text="Sala A"
                    android:textColor="#99FFFFFF"
                    android:textSize="@dimen/text_size_caption" />

                <ImageView
                    android:layout_width="@dimen/spacing_medium"
                    android:layout_height="@dimen/spacing_medium"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:src="@drawable/ic_duration"
                    app:tint="#99FFFFFF" />

                <TextView
                    android:id="@+id/tvDuracion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_tiny"
                    android:text="45 min"
                    android:textColor="#99FFFFFF"
                    android:textSize="@dimen/text_size_caption" />

                <ImageView
                    android:layout_width="@dimen/spacing_medium"
                    android:layout_height="@dimen/spacing_medium"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:src="@drawable/ic_price"
                    app:tint="#99FFFFFF" />

                <TextView
                    android:id="@+id/tvPrecio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_tiny"
                    android:text="10€"
                    android:textColor="#99FFFFFF"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#99FFFFFF"
                android:textSize="@dimen/text_size_caption"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutInfo" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
