<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1128">

    <!-- Header Background Decor -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stat_card_height"
        android:background="@drawable/gradient_dark_header"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnBackStaff"
        android:layout_width="@dimen/button_height"
        android:layout_height="@dimen/button_height"
        android:layout_margin="@dimen/spacing_medium"
        android:background="@drawable/bg_circle_translucent"
        android:padding="@dimen/spacing_small"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tvTitleStaff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestión de Staff"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_display"
        android:fontFamily="sans-serif-black"
        app:layout_constraintBottom_toBottomOf="@id/btnBackStaff"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBackStaff" />

    <TextView
        android:id="@+id/tvSubtitleStaff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Administra el equipo de entrenadores"
        android:textColor="#B3FFFFFF"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitleStaff" />

    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchViewStaff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_medium"
        android:background="@drawable/bg_search_view"
        app:iconifiedByDefault="false"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitleStaff"
        app:queryHint="Buscar por nombre o DNI..." />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStaff"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_medium"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_xlarge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchViewStaff"
        tools:listitem="@layout/item_staff" />

    <ProgressBar
        android:id="@+id/pbStaff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/accent_color"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddStaff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_large"
        android:text="Nuevo Staff"
        android:textColor="@color/white"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/white"
        app:backgroundTint="#CD0277"
        app:cornerRadius="@dimen/card_corner_radius_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>