<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/spacing_medium"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="@dimen/card_corner_radius_large"
    app:cardElevation="@dimen/card_elevation_large"
    app:strokeColor="#4DFFFFFF"
    app:strokeWidth="@dimen/stroke_width_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIBLIOTECA EXTERNA"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="@dimen/spacing_large"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: push up, squats..."
            android:textColorHint="#80FFFFFF"
            app:boxStrokeColor="@color/brand_pink"
            app:hintTextColor="@color/brand_pink"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="@color/brand_pink">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchExternal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body"
                android:imeOptions="actionSearch"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearchExternal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="BUSCAR EJERCICIOS"
            android:textColor="@color/white"
            app:backgroundTint="@color/brand_pink"
            app:cornerRadius="@dimen/card_corner_radius_small" />

        <ProgressBar
            android:id="@+id/pbLoadingExternal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="@dimen/spacing_medium"
            android:indeterminateTint="@color/brand_pink"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExternalExercises"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/spacing_medium"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_medium"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>