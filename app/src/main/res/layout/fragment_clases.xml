<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1128"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTituloClases"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HORARIO DE CLASES"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Selector de días horizontal -->
    <HorizontalScrollView
        android:id="@+id/scrollDias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tvTituloClases">

        <LinearLayout
            android:id="@+id/layoutBotonesDias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLunes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="LUNES"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="#CD0277" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMartes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="MARTES"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:alpha="0.6"
                app:cornerRadius="12dp"
                app:strokeColor="#33FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMiercoles"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="MIERCOLES"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:alpha="0.6"
                app:cornerRadius="12dp"
                app:strokeColor="#33FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJueves"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="JUEVES"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:alpha="0.6"
                app:cornerRadius="12dp"
                app:strokeColor="#33FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViernes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="VIERNES"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:alpha="0.6"
                app:cornerRadius="12dp"
                app:strokeColor="#33FFFFFF" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvClases"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollDias"
        tools:listitem="@layout/item_clase" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddClase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        android:visibility="gone"
        app:backgroundTint="#CD0277"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>