<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1128"
    android:padding="@dimen/spacing_medium">

    <TextView
        android:id="@+id/tvTituloClases"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HORARIO Y ACTIVIDADES"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_header"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutClases"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:background="@android:color/transparent"
        app:tabTextColor="#80FFFFFF"
        app:tabSelectedTextColor="@color/white"
        app:tabIndicatorColor="#CD0277"
        app:tabIndicatorHeight="@dimen/stroke_width_medium"
        app:tabRippleColor="@color/accent_color"
        app:layout_constraintTop_toBottomOf="@id/tvTituloClases">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HORARIO" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVIDADES" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Contenedor Horario -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTabHorario"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutClases">

        <!-- Chips de categorías -->
        <HorizontalScrollView
            android:id="@+id/scrollCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:scrollbars="none"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="false">
                <!-- Chips se añadirán dinámicamente -->
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Selector de días horizontal -->
        <HorizontalScrollView
            android:id="@+id/scrollDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/scrollCategorias">

            <LinearLayout
                android:id="@+id/layoutBotonesDias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/spacing_small">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLunes"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:text="LUNES"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/card_corner_radius_small"
                    app:strokeColor="#CD0277" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMartes"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:text="MARTES"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:alpha="0.6"
                    app:cornerRadius="@dimen/card_corner_radius_small"
                    app:strokeColor="#33FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMiercoles"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:text="MIERCOLES"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:alpha="0.6"
                    app:cornerRadius="@dimen/card_corner_radius_small"
                    app:strokeColor="#33FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnJueves"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:text="JUEVES"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:alpha="0.6"
                    app:cornerRadius="@dimen/card_corner_radius_small"
                    app:strokeColor="#33FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViernes"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:text="VIERNES"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:alpha="0.6"
                    app:cornerRadius="@dimen/card_corner_radius_small"
                    app:strokeColor="#33FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSabado"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:text="SABADO"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:alpha="0.6"
                    app:cornerRadius="@dimen/card_corner_radius_small"
                    app:strokeColor="#33FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDomingo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:text="DOMINGO"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:alpha="0.6"
                    app:cornerRadius="@dimen/card_corner_radius_small"
                    app:strokeColor="#33FFFFFF" />

            </LinearLayout>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvClases"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollDias"
            tools:listitem="@layout/item_clase" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Contenedor Actividades -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTabActividades"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutClases">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchViewActividades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_search_view"
            app:iconifiedByDefault="false"
            app:queryHint="Buscar actividad..."
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvActividades"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/searchViewActividades" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddClase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_large"
        android:src="@android:drawable/ic_input_add"
        android:visibility="gone"
        app:backgroundTint="#CD0277"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>