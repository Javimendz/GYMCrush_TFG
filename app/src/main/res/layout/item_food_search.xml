<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardBackgroundColor="#323C5F"
    app:cardCornerRadius="@dimen/card_corner_radius_small"
    app:strokeColor="#3AFFFFFF"
    app:strokeWidth="@dimen/stroke_width_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_small">

        <CheckBox
            android:id="@+id/cbSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/brand_pink" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFoodImage"
            android:layout_width="@dimen/viewpager_next_item_visible"
            android:layout_height="@dimen/viewpager_next_item_visible"
            android:layout_marginStart="@dimen/spacing_small"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_compras"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFoodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre Alimento"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFoodMacros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100 kcal | P: 10g | C: 20g | G: 5g"
                android:textColor="#BDBDBD"
                android:textSize="@dimen/text_size_caption"
                android:layout_marginTop="@dimen/spacing_tiny" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
