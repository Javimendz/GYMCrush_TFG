<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1128">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:id="@+id/tvTituloRutinas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rutinas y Entrenamientos"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="10dp" />

        <!-- TabLayout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutRutinas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0A1128"
            app:tabIndicatorColor="#CD0277"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabTextColor="#99FFFFFF"
            app:tabIndicatorHeight="3dp"
            app:tabRippleColor="@null">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MI AGENDA" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPLORAR" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIS RUTINAS" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Overlay de Carga IA (Invisible por defecto) -->
        <FrameLayout
            android:id="@+id/overlayIA"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E60A1128"
            android:elevation="10dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:gravity="center">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieIA"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:lottie_rawRes="@raw/stationary_biking"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_speed="1.5"/>
                <TextView
                    android:id="@+id/tvEstadoIA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IA Optimizando tu rutina..."
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Progreso de la Rutina -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressRutina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            app:indicatorColor="#CD0277"
            app:trackColor="#33FFFFFF"
            app:trackCornerRadius="4dp"
            android:progress="0" />

        <!-- Selector de Fecha Horizontal (Burbujas) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCalendarioHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="10dp"
            android:background="#0A1128"
            android:clipToPadding="false"
            android:orientation="horizontal" />

        <!-- Selector de Fecha Antiguo (Oculto) -->
        <LinearLayout
            android:id="@+id/layoutSelectorFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="5dp"
            android:gravity="center_vertical"
            android:background="#16213E"
            android:visibility="gone">
             <TextView
                android:id="@+id/tvFechaSeleccionada"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hoy"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Contenedor de RUTINAS -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/containerRutinas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="100dp">

                    <!-- Fase 4: Gráfica de Evolución -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:background="#16213E"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TU EVOLUCIÓN (Últimos 7 días)"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:alpha="0.7"
                                    android:layout_alignParentStart="true"/>

                                <TextView
                                    android:id="@+id/tvRacha"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Racha: --"
                                    android:textColor="#FFD700"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_alignParentEnd="true"
                                    android:background="@drawable/bg_racha_badge"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="2dp"/>
                            </RelativeLayout>

                            <com.example.gymcrush.ui.salud.ProgressGraphView
                                android:id="@+id/graphEvolucionRutinas"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>



                    <!-- Carrusel de Rutinas (ViewPager2) -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpRutinasFavoritas"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="16dp" />

                    <!-- Dots Indicator -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/dotsIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        app:tabBackground="@drawable/tab_selector_dot"
                        app:tabGravity="center"
                        app:tabIndicatorHeight="0dp"
                        app:tabMaxWidth="12dp"
                        app:tabRippleColor="@null" />


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMisRutinas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Contenedor de PLANES -->
            <FrameLayout
                android:id="@+id/containerPlanes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Contenedor de MIS RUTINAS GUARDADAS -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/containerRutinasGuardadas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:paddingBottom="100dp">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRutinasGuardadas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Contenedor de ENTRENAMIENTOS -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/containerEntrenamientos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="100dp">

                    <!-- Categorías Horizontal -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="10dp"
                        app:hintEnabled="false"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBuscarEjercicio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Buscar por nombre..."
                            android:textColor="#FFFFFF"
                            android:textColorHint="#66FFFFFF"
                            android:background="@drawable/bg_search_view"
                            android:padding="12dp"
                            android:maxLines="1"
                            android:inputType="text"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayoutCategorias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#0A1128"
                        app:tabMode="scrollable"
                        app:tabIndicatorColor="#CD0277"
                        app:tabSelectedTextColor="#FFFFFF"
                        app:tabTextColor="#99FFFFFF"
                        app:tabRippleColor="@null"
                        android:layout_marginBottom="8dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvEjerciciosRegistrados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <LinearLayout
                        android:id="@+id/layoutEjerciciosVacio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="40dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/ic_menu"
                            app:tint="#33FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No hay entrenamientos en esta categoría."
                            android:textColor="#66FFFFFF"
                            android:layout_marginTop="16dp"
                            android:gravity="center"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnIrACrear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="@color/white"
        app:backgroundTint="#CD0277"
        app:layout_constraintBottom_toTopOf="@id/fabAddEjercicioAdmin"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddEjercicioAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="NUEVO"
        android:textColor="@color/white"
        android:visibility="gone"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/white"
        app:backgroundTint="#CD0277"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>