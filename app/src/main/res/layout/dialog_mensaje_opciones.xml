<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#0A1128">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OPCIONES"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:letterSpacing="0.1"
            android:layout_gravity="center"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_opcion_copiar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COPIAR MENSAJE"
            android:textColor="#94A3B8"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            app:icon="@drawable/ic_send_neon"
            app:iconTint="#94A3B8"
            android:textAllCaps="true"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_opcion_editar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EDITAR MENSAJE"
            android:textColor="#94A3B8"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            app:icon="@drawable/ic_perfil"
            app:iconTint="#94A3B8"
            android:textAllCaps="true"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_opcion_eliminar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ELIMINAR MENSAJE"
            android:textColor="#CD0277"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            app:icon="@drawable/ic_salir"
            app:iconTint="#CD0277"
            android:textAllCaps="true"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginVertical="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_opcion_cancelar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CANCELAR"
            android:textColor="#94A3B8" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>