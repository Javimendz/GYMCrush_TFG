<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/card_corner_radius_large"
    app:cardElevation="@dimen/card_elevation_large"
    app:cardBackgroundColor="@color/card_surface"
    app:strokeColor="#4DFFFFFF"
    app:strokeWidth="@dimen/stroke_width_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OPCIONES"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_large"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/btn_opcion_copiar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COPIAR MENSAJE"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/text_size_body"
            android:paddingVertical="@dimen/spacing_medium"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_opcion_editar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EDITAR MENSAJE"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/text_size_body"
            android:paddingVertical="@dimen/spacing_medium"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_opcion_eliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ELIMINAR MENSAJE"
            android:textColor="@color/brand_pink"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:paddingVertical="@dimen/spacing_medium"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginVertical="@dimen/spacing_medium"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_opcion_cancelar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:text="CANCELAR"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/text_size_body"
            android:layout_gravity="end"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>