<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#0A1128">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OPCIONES"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/btn_opcion_copiar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COPIAR MENSAJE"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:paddingVertical="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_opcion_editar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EDITAR MENSAJE"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:paddingVertical="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_opcion_eliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ELIMINAR MENSAJE"
            android:textColor="#CD0277"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginVertical="12dp"/>

        <TextView
            android:id="@+id/btn_opcion_cancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANCELAR"
            android:textColor="#64B5F6"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_gravity="end"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>