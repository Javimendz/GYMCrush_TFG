<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1128">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#121B3A">

            <ImageButton
                android:id="@+id/btnBackDetalle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back_arrow"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DETALLE DE"
                android:textColor="#99FFFFFF"
                android:textSize="14sp"
                android:letterSpacing="0.1" />
            <TextView
                android:id="@+id/tvTituloDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOMBRE RUTINA"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupHeaderTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="12dp"
                app:chipSpacingVertical="8dp">

                <TextView
                    android:id="@+id/tvDuracionDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- min"
                    android:textColor="#FFC107"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="#33FFC107"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"/>

                <TextView
                    android:id="@+id/tvIntensidadDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intensidad: --"
                    android:textColor="#03A9F4"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="#3303A9F4"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"/>

                <TextView
                    android:id="@+id/tvVistasDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 vistas"
                    android:textColor="#8BC34A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="#338BC34A"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tvEstadoCompletadoDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COMPLETADA ✓"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_estado_completado"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvLabelEjercicios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EJERCICIOS"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEjerciciosDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompletarRutina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COMPLETAR RUTINA"
                android:textColor="#FFFFFF"
                android:backgroundTint="#CD0277"
                app:cornerRadius="12dp"
                android:padding="16dp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VOLVER A MIS RUTINAS"
                android:textColor="#FFFFFF"
                android:backgroundTint="#444444"
                app:cornerRadius="12dp"
                android:padding="16dp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Contenedor para el fragmento del reproductor -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</RelativeLayout>