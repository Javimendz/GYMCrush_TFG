<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android_custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarGestionar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FF4D4D"
        android_custom:titleTextColor="@color/white"
        android_custom:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDetallePlan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android_custom:layout_constraintTop_toBottomOf="@id/toolbarGestionar"
        android_custom:layout_constraintBottom_toBottomOf="parent"
        android_custom:layout_constraintStart_toStartOf="parent"
        android_custom:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_detalle_plan" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddEjercicioDetalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        android_custom:layout_constraintBottom_toBottomOf="parent"
        android_custom:layout_constraintEnd_toEndOf="parent"
        android_custom:tint="@color/white"
        android_custom:backgroundTint="#FF4D4D" />

</androidx.constraintlayout.widget.ConstraintLayout>