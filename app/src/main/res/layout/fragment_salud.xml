<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1128"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salud e IMC"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="@dimen/spacing_large"
            android:gravity="center"
            android:letterSpacing="0.1"/>

        <!-- Card Avances de Salud -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation_large"
            app:cardBackgroundColor="#1C253E"
            app:strokeWidth="0dp"
            android:layout_marginBottom="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVANCES DE SALUD"
                    android:textStyle="bold"
                    android:textColor="@color/brand_pink"
                    android:textSize="@dimen/text_size_body"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="@dimen/spacing_medium"/>

                <!-- Gráfico de Progreso -->
                <com.example.gymcrush.ui.salud.ProgressGraphView
                    android:id="@+id/graphView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/workout_image_height"
                    android:background="#05FFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Evolución del peso en los últimos registros"
                    android:textSize="@dimen/text_size_caption"
                    android:textColor="#99FFFFFF"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/spacing_small"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card IMC -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation_large"
            app:cardBackgroundColor="#1C253E"
            app:strokeWidth="0dp"
            android:layout_marginBottom="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IMC"
                    android:textStyle="bold"
                    android:textColor="@color/brand_pink"
                    android:textSize="@dimen/text_size_body"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="@dimen/spacing_medium"/>

                <FrameLayout
                    android:layout_width="@dimen/stat_card_height"
                    android:layout_height="@dimen/stat_card_height">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/imcProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="65"
                        app:indicatorColor="@color/brand_pink"
                        app:indicatorSize="140dp"
                        app:trackColor="#33FFFFFF"
                        app:trackThickness="@dimen/spacing_small" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvImcValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="23.5"
                            android:textSize="@dimen/text_size_headline"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>

                        <TextView
                            android:id="@+id/tvImcStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Normal"
                            android:textSize="@dimen/text_size_body"
                            android:textColor="#99FFFFFF"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Historia -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation_large"
            app:cardBackgroundColor="#1C253E"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginBottom="@dimen/spacing_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HISTORIAL"
                        android:textStyle="bold"
                        android:textColor="@color/brand_pink"
                        android:textSize="@dimen/text_size_body"
                        android:letterSpacing="0.1"/>

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_back_arrow"
                        android:rotation="180"
                        app:tint="#99FFFFFF"/>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_small">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Peso actual:"
                        android:textColor="#99FFFFFF"
                        android:textSize="@dimen/text_size_body"/>
                    <TextView
                        android:id="@+id/tvPesoActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="75.0 kg"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_body"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Altura:"
                        android:textColor="#99FFFFFF"
                        android:textSize="@dimen/text_size_body"/>
                    <TextView
                        android:id="@+id/tvAltura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="178 cm"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_body"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarSalud"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="EDITAR DATOS"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/spacing_small"
            app:cornerRadius="@dimen/card_corner_radius_small"
            android:backgroundTint="@color/brand_pink"
            android:textColor="@color/white"
            app:elevation="@dimen/card_elevation_large"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>