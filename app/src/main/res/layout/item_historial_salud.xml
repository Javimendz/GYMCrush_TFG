<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#252F4D"
    app:strokeWidth="1dp"
    app:strokeColor="#1AFFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvFechaItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="01/01/2024"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvPesoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75.0 kg"
                android:textColor="#CD0277"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvActividadItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actividad: Moderada"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvComentarioItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comentario: Progreso constante"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            android:fontStyle="italic"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>