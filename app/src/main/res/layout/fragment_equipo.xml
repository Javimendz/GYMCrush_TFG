<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark"
    android:orientation="vertical">

    <!-- Header similar al de contrataciones -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/primary_dark">

        <ImageView
            android:id="@+id/btnBackEquipo"
            android:layout_width="@dimen/button_height"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_small"
            android:padding="@dimen/spacing_medium"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/brand_pink"
            android:contentDescription="Volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuestro Equipo"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <!-- José García -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_entrenador1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_small"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/card_surface"
                    app:strokeColor="#1AFFFFFF"
                    app:strokeWidth="@dimen/stroke_width_thin"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/img_entrenador1"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/trainer_image_height"
                            android:scaleType="centerCrop"
                            android:src="@drawable/joseee" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_medium">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="José García"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FrontEnd"
                                android:textColor="#B0B0B0"
                                android:textSize="@dimen/text_size_micro"
                                android:layout_marginTop="@dimen/spacing_tiny"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- María Brotons (Placeholder con Iniciales) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_entrenadora1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_small"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/card_surface"
                    app:strokeColor="#1AFFFFFF"
                    app:strokeWidth="@dimen/stroke_width_thin"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/trainer_image_height"
                            android:background="@drawable/bg_initials_gradient">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MB"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_display"
                                android:textStyle="bold"
                                android:layout_gravity="center"/>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_medium">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="María Brotons"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FrontEnd"
                                android:textColor="#B0B0B0"
                                android:textSize="@dimen/text_size_micro"
                                android:layout_marginTop="@dimen/spacing_tiny"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Javier Méndez (Placeholder con Iniciales) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_entrenador2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_small"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/card_surface"
                    app:strokeColor="#1AFFFFFF"
                    app:strokeWidth="@dimen/stroke_width_thin"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/trainer_image_height"
                            android:background="@drawable/bg_initials_gradient">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JM"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_display"
                                android:textStyle="bold"
                                android:layout_gravity="center"/>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_medium">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Javier Méndez"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BackEnd"
                                android:textColor="#B0B0B0"
                                android:textSize="@dimen/text_size_micro"
                                android:layout_marginTop="@dimen/spacing_tiny"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Andrea -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_entrenadora2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_small"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/card_surface"
                    app:strokeColor="#1AFFFFFF"
                    app:strokeWidth="@dimen/stroke_width_thin"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/img_entrenadora2"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/trainer_image_height"
                            android:scaleType="centerCrop"
                            android:src="@drawable/maria" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_medium">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Andrea"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_body"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BackEnd"
                                android:textColor="#B0B0B0"
                                android:textSize="@dimen/text_size_micro"
                                android:layout_marginTop="@dimen/spacing_tiny"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

