<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation_small"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="@dimen/stroke_width_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_medium"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivIconoComida"
            android:layout_width="@dimen/food_item_icon_size"
            android:layout_height="@dimen/food_item_icon_size"
            android:background="#0DFFFFFF"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_compras"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvTituloComida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desayuno"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_subheading"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescripcionComida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tortitas de avena con claras y crema de cacahuete."
                android:textColor="#99FFFFFF"
                android:textSize="@dimen/text_size_caption"
                android:layout_marginTop="@dimen/spacing_tiny" />

            <TextView
                android:id="@+id/tvMacrosComida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="350 kcal | P: 20g | C: 40g | G: 10g"
                android:textColor="@color/brand_pink"
                android:textSize="@dimen/text_size_micro"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHoraComida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:30"
                android:textColor="#CD0277"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivMenuComida"
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:layout_marginTop="@dimen/spacing_small"
                android:padding="@dimen/spacing_tiny"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/white"
                android:alpha="0.6" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
