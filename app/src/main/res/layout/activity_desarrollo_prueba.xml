<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#0A1128"
    tools:context=".ui.main.DesarrolloActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Toolbar con efecto Glassmorphism -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/customToolbar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:paddingHorizontal="16dp"
            android:background="#0A1128"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/btnMenuLateral"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                app:tint="#CD0277"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GYMCRUSH"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Campana de Notificaciones Animada -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/btnNotificationsAnim"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:lottie_rawRes="@raw/notification_bell"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Contenedor para Fragmentos -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/customToolbar"
            app:layout_constraintBottom_toTopOf="@id/bottomNavContainer">

            <!-- Contenido Inicial (Home) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/home_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="false"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header con Avatar Dinámico (Glide) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/profile_image"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvSaludo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="¡A tope, Admin!"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFecha"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cargando fecha..."
                                android:textColor="#99FFFFFF"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/profile_image"
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logo"
                            app:strokeColor="#CD0277"
                            app:strokeWidth="3dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/CircleImage" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Imagen de Entrenamiento Semitransparente -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivWorkoutImage"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginBottom="16dp"
                        android:scaleType="centerCrop"
                        android:alpha="0.6"
                        android:src="@drawable/mujer_deporte"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.RoundedSquare"
                        tools:src="@tools:sample/backgrounds/scenic" />

                    <!-- Card de Próxima Clase con Estilo Neumórfico -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="20dp"
                        app:strokeWidth="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_login_modern"
                            android:padding="24dp">

                            <TextView
                                android:id="@+id/lblNextClass"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RETO DEL DÍA"
                                android:textColor="@color/accent_color"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tvNombreClase"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Full Body Blast"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/lblNextClass" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEmpezar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="¡EMPEZAR AHORA!"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:backgroundTint="@color/accent_color"
                                android:textColor="@color/white"
                                app:cornerRadius="12dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvNombreClase" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Mapa con estilo nocturno -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu Centro de Entrenamiento"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="8dp"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp">

                        <fragment
                            android:id="@+id/map"
                            android:name="com.google.android.gms.maps.SupportMapFragment"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <!-- Bottom Navigation Totalmente Integrado -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/botton_nav"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:background="@android:color/transparent"
                app:elevation="0dp"
                app:itemIconSize="26dp"
                app:itemIconTint="@color/nav_item_color"
                app:itemTextColor="@color/nav_item_color"
                app:labelVisibilityMode="unlabeled"
                app:menu="@menu/nav_menu"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer Modernizado -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:background="#0A1128"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_desplegable"
        app:itemTextColor="#CCFFFFFF"
        app:itemIconTint="#CCFFFFFF"
        app:itemHorizontalPadding="24dp"
        app:itemIconPadding="20dp"
        app:itemShapeFillColor="#1AFFFFFF"
        app:itemShapeAppearanceOverlay="@style/ShapeAppearance.App.RoundedSquare"
        app:itemVerticalPadding="12dp" />

</androidx.drawerlayout.widget.DrawerLayout>