<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#0A1128"
    tools:context=".ui.main.DesarrolloActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Toolbar con efecto Glassmorphism -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/customToolbar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:paddingHorizontal="16dp"
            android:background="#0A1128"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/btnMenuLateral"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                app:tint="#CD0277"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GYMCRUSH"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Campana de Notificaciones Animada -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/btnNotificationsAnim"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:lottie_rawRes="@raw/notification_bell"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Contenedor para Fragmentos -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/customToolbar"
            app:layout_constraintBottom_toTopOf="@id/bottomNavContainer">

            <!-- Contenido Inicial (Home) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/home_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="false"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header con Avatar Dinámico (Glide) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/profile_image"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvSaludo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="¡A tope, Admin!"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFecha"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cargando fecha..."
                                android:textColor="#99FFFFFF"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/profile_image"
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logo"
                            app:strokeColor="#CD0277"
                            app:strokeWidth="3dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/CircleImage" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- SECCIÓN DE ESTADÍSTICAS NEÓN -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu Rendimiento Semanal"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp"
                        android:weightSum="2">

                        <!-- Card de Entrenamiento -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="0dp"
                            android:layout_height="160dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_stat_glow"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvStatTitle1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Actividad"
                                android:textColor="#B3FFFFFF"
                                android:textSize="12sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progressCircularStat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:indicatorSize="70dp"
                                app:trackThickness="8dp"
                                app:indicatorColor="#CD0277"
                                app:trackColor="#1AFFFFFF"
                                app:trackCornerRadius="10dp"
                                android:progress="75"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvStatTitle1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="75%"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="@id/progressCircularStat"
                                app:layout_constraintEnd_toEndOf="@id/progressCircularStat"
                                app:layout_constraintStart_toStartOf="@id/progressCircularStat"
                                app:layout_constraintTop_toTopOf="@id/progressCircularStat" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Card de Peso/Calorías -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="0dp"
                            android:layout_height="160dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_stat_glow"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvStatTitle2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Calorías"
                                android:textColor="#B3FFFFFF"
                                android:textSize="12sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tvStatValue2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="1,250"
                                android:textColor="@color/white"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvStatTitle2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="kcal quemadas"
                                android:textColor="#4FC3F7"
                                android:textSize="12sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvStatValue2" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:indicatorColor="#4FC3F7"
                                app:trackColor="#1AFFFFFF"
                                app:trackCornerRadius="4dp"
                                android:progress="60"
                                app:layout_constraintBottom_toBottomOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>

                    <!-- Imagen de Entrenamiento Semitransparente -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivWorkoutImage"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginBottom="16dp"
                        android:scaleType="centerCrop"
                        android:alpha="0.6"
                        android:src="@drawable/mujer_deporte"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.RoundedSquare"
                        tools:src="@tools:sample/backgrounds/scenic" />

                    <!-- Card de Nutrición Widget -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNutricionWidget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:visibility="visible"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="20dp"
                        app:strokeWidth="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_login_modern"
                            android:padding="24dp">

                            <TextView
                                android:id="@+id/lblPlanActivo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MI PLAN NUTRICIONAL"
                                android:textColor="@color/accent_color"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tvNombrePlanWidget"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Sin plan activo"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/lblPlanActivo" />

                            <TextView
                                android:id="@+id/tvCaloriasWidget"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Consulta con tu nutricionista"
                                android:textColor="#99FFFFFF"
                                android:textSize="14sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvNombrePlanWidget" />

                            <!-- Mini Macro Progress -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="16dp"
                                android:weightSum="3"
                                app:layout_constraintTop_toBottomOf="@id/tvCaloriasWidget">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P" android:textColor="#CD0277" android:textSize="10sp" android:textStyle="bold"/>
                                    <com.google.android.material.progressindicator.LinearProgressIndicator
                                        android:id="@+id/progressProt"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:layout_marginEnd="8dp"
                                        app:indicatorColor="#CD0277"
                                        app:trackColor="#33FFFFFF"
                                        app:trackCornerRadius="4dp"
                                        android:progress="0"/>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C" android:textColor="#4CAF50" android:textSize="10sp" android:textStyle="bold"/>
                                    <com.google.android.material.progressindicator.LinearProgressIndicator
                                        android:id="@+id/progressCarb"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:layout_marginEnd="8dp"
                                        app:indicatorColor="#4CAF50"
                                        app:trackColor="#33FFFFFF"
                                        app:trackCornerRadius="4dp"
                                        android:progress="0"/>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="G" android:textColor="#FFC107" android:textSize="10sp" android:textStyle="bold"/>
                                    <com.google.android.material.progressindicator.LinearProgressIndicator
                                        android:id="@+id/progressGras"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        app:indicatorColor="#FFC107"
                                        app:trackColor="#33FFFFFF"
                                        app:trackCornerRadius="4dp"
                                        android:progress="0"/>
                                </LinearLayout>
                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>


                    <!-- Carrusel de Información en Tiempo Real -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sugerencias para ti"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerCarousel"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginBottom="24dp"
                        android:clipToPadding="false"
                        android:clipChildren="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ejercicios recomendados"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerExerciseCarousel"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginBottom="24dp"
                        android:clipToPadding="false"
                        android:clipChildren="false" />

                    <!-- Sección de Noticias IA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="IA Fitness Insights"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <com.airbnb.lottie.LottieAnimationView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            app:lottie_rawRes="@raw/notification_bell"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardIANews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="4dp"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="#121B3A"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvIANewsTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Generando noticia del día..."
                                android:textColor="#CD0277"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvIANewsContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Analizando tendencias de entrenamiento con inteligencia artificial..."
                                android:textColor="#B3FFFFFF"
                                android:textSize="14sp"
                                android:lineSpacingExtra="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:layout_gravity="end"
                                android:text="Powered by GymCrush IA"
                                android:textColor="#66FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="italic" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Mapa con estilo nocturno -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu Centro de Entrenamiento"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="8dp"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp">

                        <fragment
                            android:id="@+id/map"
                            android:name="com.google.android.gms.maps.SupportMapFragment"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <!-- Bottom Navigation Totalmente Integrado -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/botton_nav"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:background="@android:color/transparent"
                app:elevation="0dp"
                app:itemIconSize="26dp"
                app:itemIconTint="@color/nav_item_color"
                app:itemTextColor="@color/nav_item_color"
                app:labelVisibilityMode="unlabeled"
                app:menu="@menu/nav_menu"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer Modernizado -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0F1733"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_desplegable"
        app:itemTextColor="#E6FFFFFF"
        app:itemIconTint="#CD0277"
        app:itemHorizontalPadding="16dp"
        app:itemIconSize="22dp"
        app:itemIconPadding="16dp"
        app:itemBackground="@drawable/bg_nav_item"
        app:itemShapeAppearanceOverlay="@style/ShapeAppearance.App.RoundedSquare"
        android:paddingTop="0dp"
        android:clipToPadding="false" />

</androidx.drawerlayout.widget.DrawerLayout>