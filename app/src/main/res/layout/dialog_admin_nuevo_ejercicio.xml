<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_medium"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="@dimen/card_corner_radius_large"
    app:cardElevation="@dimen/card_elevation_large"
    app:strokeColor="#4DFFFFFF"
    app:strokeWidth="@dimen/stroke_width_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NUEVO ENTRENAMIENTO"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="@dimen/spacing_large"
            android:layout_gravity="center"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="Nombre"
            android:textColorHint="#80FFFFFF"
            app:boxStrokeColor="@color/brand_pink"
            app:hintTextColor="@color/brand_pink">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombreEjercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="Descripción"
            android:textColorHint="#80FFFFFF"
            app:boxStrokeColor="@color/brand_pink"
            app:hintTextColor="@color/brand_pink">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcionEjercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body"
                android:gravity="top"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="Categoría (Ej: Pecho, Espalda, Cardio)"
            android:textColorHint="#80FFFFFF"
            app:boxStrokeColor="@color/brand_pink"
            app:hintTextColor="@color/brand_pink">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCategoriaEjercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="Duración (min)"
            android:textColorHint="#80FFFFFF"
            app:boxStrokeColor="@color/brand_pink"
            app:hintTextColor="@color/brand_pink">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDuracionEjercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:hint="Equipamiento (Ej: Mancuernas, Barra)"
            android:textColorHint="#80FFFFFF"
            app:boxStrokeColor="@color/brand_pink"
            app:hintTextColor="@color/brand_pink">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIntensidadEjercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarEjercicio"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="GUARDAR ENTRENAMIENTO"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_pink"
            app:cornerRadius="@dimen/card_corner_radius_small" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>