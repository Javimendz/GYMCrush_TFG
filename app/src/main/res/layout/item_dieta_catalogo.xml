<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/diet_card_height"
    android:layout_margin="@dimen/spacing_small"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivDietaFondo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/mujer_deporte" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_overlay_original" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large"
            android:gravity="bottom">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_small">

                <TextView
                    android:id="@+id/tvBadgeTipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/brand_pink"
                    android:paddingHorizontal="@dimen/spacing_small"
                    android:paddingVertical="@dimen/stroke_width_medium"
                    android:text="ALTA PROTEÍNA"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_micro"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNombreDieta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de la Dieta"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_header"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescripcionDieta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Descripción de la dieta..."
                android:textColor="#E0E0E0"
                android:textSize="@dimen/text_size_body" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <TextView
                    android:id="@+id/tvCaloriasDieta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="2500 kcal"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerDetalles"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_small"
                    android:layout_alignParentEnd="true"
                    android:paddingHorizontal="@dimen/spacing_medium"
                    android:text="VER MÁS"
                    android:textColor="@color/brand_pink"
                    android:textSize="@dimen/text_size_caption"
                    app:cornerRadius="@dimen/spacing_large"
                    app:strokeColor="@color/brand_pink" />
            </RelativeLayout>
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
