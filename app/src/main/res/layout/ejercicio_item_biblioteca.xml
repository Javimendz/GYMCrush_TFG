<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardEjercicio"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#121B3A"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Lado izquierdo: Imagen del ejercicio -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgEjercicioIcono"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo"
            app:shapeAppearanceOverlay="@style/RoundedImage"
            app:strokeColor="#22FFFFFF"
            app:strokeWidth="1dp"
            android:layout_marginEnd="16dp" />

        <!-- Lado derecho: Info del ejercicio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreEj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Ejercicio"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCatEj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoría"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <!-- Etiquetas de Duración y Músculo -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupEjercicioTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp">

                <!-- Tag Duración -->
                <LinearLayout
                    android:id="@+id/layoutDuracionTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_chip_yellow"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_duration"
                        app:tint="#FFFFFF"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tvDuracionTagItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 min"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Tag Músculo/Intensidad -->
                <LinearLayout
                    android:id="@+id/layoutMusculoTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_neon_card"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvMusculoTagItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PECHO"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Tag Global/Personal -->
                <LinearLayout
                    android:id="@+id/layoutGlobalTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_chip_global"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvGlobalTagItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFICIAL"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </com.google.android.material.chip.ChipGroup>

            <!-- Texto para series y reps en modo detalle -->
            <TextView
                android:id="@+id/tvRepsSeries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 Series x 12 Reps"
                android:textColor="#CD0277"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvDescripcionEj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción del ejercicio..."
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Checkbox de completado para el detalle de rutina -->
        <CheckBox
            android:id="@+id/cbCompletado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#CD0277"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgMenuEjercicio"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_menu"
            app:tint="#CD0277"
            android:alpha="0.8" />

        <!-- Mantenemos IDs para no romper el Adapter -->
        <TextView
            android:id="@+id/tvDificultad"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>