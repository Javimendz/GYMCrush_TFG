<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardEjercicio"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#121B3A"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <!-- Lado izquierdo: Info del ejercicio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreEj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Ejercicio"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCatEj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoría"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <!-- Texto para series y reps en modo detalle -->
            <TextView
                android:id="@+id/tvRepsSeries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 Series x 12 Reps"
                android:textColor="#CD0277"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvDescripcionEj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción del ejercicio..."
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Checkbox de completado para el detalle de rutina -->
        <CheckBox
            android:id="@+id/cbCompletado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#CD0277"
            android:visibility="gone" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_menu"
            app:tint="#CD0277"
            android:alpha="0.8" />

        <!-- Mantenemos IDs para no romper el Adapter -->
        <TextView
            android:id="@+id/tvDificultad"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgEjercicioIcono"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>