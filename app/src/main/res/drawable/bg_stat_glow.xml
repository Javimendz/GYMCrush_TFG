<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Resplandor exterior (Sombra difusa simulada) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#0DCD0277" />
        </shape>
    </item>
    <!-- Borde neón -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:startColor="#CD0277"
                android:endColor="#4FC3F7"
                android:angle="45" />
        </shape>
    </item>
    <!-- Fondo oscuro -->
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#1A2238" />
        </shape>
    </item>
</layer-list>