<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradiente de fondo principal (Oscuro Elegante) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#162244"
                android:endColor="#050914"
                android:startColor="#1B2B5A"
                android:type="linear" />
        </shape>
    </item>

    <!-- Círculo decorativo superior derecho -->
    <item
        android:top="-100dp"
        android:right="-100dp">
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" />
            <size android:width="300dp" android:height="300dp" />
        </shape>
    </item>

    <!-- Círculo decorativo medio izquierdo -->
    <item
        android:top="200dp"
        android:left="-50dp">
        <shape android:shape="oval">
            <solid android:color="#0DFFFFFF" />
            <size android:width="150dp" android:height="150dp" />
        </shape>
    </item>
</layer-list>