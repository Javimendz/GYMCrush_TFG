<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- El "glow" o borde neón rosa completo -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_corner_radius" />
            <solid android:color="@color/brand_pink" />
        </shape>
    </item>

    <!-- El fondo oscuro interior (reducido para que se vea el borde) -->
    <item
        android:bottom="@dimen/stroke_width_medium"
        android:left="@dimen/stroke_width_medium"
        android:right="@dimen/stroke_width_medium"
        android:top="@dimen/stroke_width_medium">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_corner_radius_small" />
            <solid android:color="@color/card_surface" />
        </shape>
    </item>
</layer-list>