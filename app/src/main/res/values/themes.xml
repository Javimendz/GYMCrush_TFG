<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GYMCrush" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">#0A1128</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#CD0277</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorTertiary">#303F9F</item>

        <!-- Tonal Button attributes -->
        <item name="colorSecondaryContainer">#E1E2EC</item>
        <item name="colorOnSecondaryContainer">#191C1E</item>
        <item name="colorContainerUnchecked">@android:color/transparent</item>

        <item name="android:statusBarColor">#0A1128</item>

        <!-- AppCompat compatibility attributes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Estilo personalizado para el Calendario (DatePicker) -->
    <style name="CustomDatePickerTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">#0A1128</item> <!-- Azul oscuro de la cabecera de la app -->
        <item name="colorPrimaryDark">#0A1128</item>
        <item name="colorAccent">#CD0277</item> <!-- Acento rosa neón para selección y botones -->

        <!-- Fondo sólido del diálogo -->
        <item name="android:windowBackground">@drawable/bg_dialog_solid</item>

        <!-- Colores de texto -->
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B0FFFFFF</item>
        <item name="android:textColorPrimaryInverse">#FFFFFF</item>

        <!-- Quitar efecto translúcido -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:background">#1A2238</item>

        <item name="shapeAppearanceMediumComponent">@style/DialogRoundedCorner</item>
    </style>

    <style name="DialogRoundedCorner" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="MaterialAlertDialog_Rounded" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogRoundedCorner</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A1128</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="postSplashScreenTheme">@style/Theme.GYMCrush</item>

        <!-- AppCompat compatibility attributes for the starting theme -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.GYMCrush" parent="Base.Theme.GYMCrush" />

    <style name="ShapeAppearance.App.CircleComponent" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.App.RoundedSquare" parent="">
        <item name="cornerSize">12dp</item>
    </style>
</resources>