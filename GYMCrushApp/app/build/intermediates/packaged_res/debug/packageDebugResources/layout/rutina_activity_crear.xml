<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8F9FA"> <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="NUEVA RUTINA"
    android:textSize="22sp"
    android:textStyle="bold"
    android:textColor="#333333"
    android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etNombreRutina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: Rutina de pecho"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:layout_marginBottom="25dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona los ejercicios:"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="10dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSeleccionEjercicios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnGuardarRutina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GUARDAR RUTINA"
        android:backgroundTint="#007BFF"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:padding="15dp"/>

</LinearLayout>