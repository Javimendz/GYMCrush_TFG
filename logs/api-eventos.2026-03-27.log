        u1_0.qr_token,
        r1_0.user_id,
        r1_1.id,
        r1_1.name,
        u1_0.telefono,
        u1_0.token_expira_en,
        u1_0.updated_at,
        u1_0.username 
    from
        perfiles p1_0 
    join
        usuarios u1_0 
            on u1_0.id=p1_0.usuario_id 
    left join
        users_roles r1_0 
            on u1_0.id=r1_0.user_id 
    left join
        roles r1_1 
            on r1_1.id=r1_0.role_id 
    where
        p1_0.usuario_id=?
